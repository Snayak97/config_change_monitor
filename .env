# Application Settings
APP_NAME="Config Change Monitoring System"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
DEBUG=false
# DEBUG=true
LOG_LEVEL="INFO"
LOG_FORMAT="console"

# File Watcher Settings
WATCH_PATHS=["./sample_configs"]
DEBOUNCE_INTERVAL_SECONDS=0.5
MAX_READ_RETRIES=3
READ_RETRY_DELAY_SECONDS=0.1
ENABLE_HASH_CHECK=true

# Event Bus & Queue Settings
QUEUE_MAX_SIZE=5000
QUEUE_WORKER_CONCURRENCY=4

# Notification Settings
WEBHOOK_URL="http://localhost:8000/api/v1/test-webhook"
WEBHOOK_TIMEOUT_SECONDS=5.0
WEBHOOK_SECRET="super-secret-signature-key"
SLACK_WEBHOOK_URL=""

# Retry & Circuit Breaker Settings
MAX_RETRIES=4
RETRY_INITIAL_DELAY_SECONDS=1.0
RETRY_BACKOFF_MULTIPLIER=2.0
RETRY_MAX_DELAY_SECONDS=30.0
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=20.0

# Storage & Audit
AUDIT_DB_PATH="./audit_events.db"
SNAPSHOT_CACHE_SIZE=2000
DLQ_MAX_SIZE=1000
